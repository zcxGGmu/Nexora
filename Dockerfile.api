FROM node:22.13.0-bookworm-slim

WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

COPY . .
RUN pnpm install --frozen-lockfile

ENV NEXORA_DATA_DIR=/var/lib/nexora \
    NEXORA_DB_PATH=/var/lib/nexora/nexora.sqlite \
    NEXORA_API_HOST=0.0.0.0 \
    NEXORA_API_PORT=4310 \
    NEXORA_AUTH_MODE=disabled \
    NEXORA_MIGRATION_MODE=auto

EXPOSE 4310
CMD ["pnpm", "--filter", "@nexora/api", "start"]
